        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\ndirection TB\nclass Person {\n  &lt;&lt;abstract&gt;&gt;\n  -UUID personId\n  -String fullName\n  -String email\n  -String phone\n  -PersonStatus status\n  +login() bool\n  +logout() void\n  +verifyOtp(code) bool\n}\nclass VaultOwner {\n  +createVault() Vault\n  +assignBeneficiary(asset, beneficiary) void\n  +configureDeadManSwitch(config) void\n  +appointExecutor(executor) void\n  +revokeExecutor(executor) void\n  +viewAccessLog() List\n}\nclass DigitalExecutor {\n  +viewAssignedAssets() List\n  +submitVerificationRequest(cert) void\n  +trackHandoverProgress() HandoverProgress\n}\nclass Beneficiary {\n  -KycStatus kycStatus\n  +verifyIdentity() bool\n  +viewInheritedAssets() List\n  +downloadAsset(asset) File\n  +confirmReceipt(asset) void\n}\nclass LegalVerifier {\n  -String licenseNo\n  +reviewRequest(request) void\n  +verifySignature(doc) bool\n  +signApproval(request) void\n}\nclass SystemAdministrator {\n  +manageUsers() void\n  +monitorAuditLog() List\n  +configurePolicy(policy) void\n}\nclass Vault {\n  -UUID vaultId\n  -String encryptionKeyRef\n  -VaultStatus status\n  +lock() void\n  +unlock() void\n}\nclass DigitalAsset {\n  -UUID assetId\n  -AssetType type\n  -String name\n  -Bytes encryptedData\n  +encrypt() void\n  +decrypt() Bytes\n}\nclass LegalDocument {\n  -UUID docId\n  -DocType docType\n  -Bytes encryptedFile\n  -String fileHash\n}\nclass DeadManSwitch {\n  -int checkInIntervalDays\n  -int gracePeriodDays\n  -DateTime lastCheckInAt\n  -SwitchStatus status\n  +recordCheckIn() void\n  +trigger() HandoverProgress\n}\nclass CheckInNotification {\n  -DateTime sentAt\n  -DateTime deadline\n  -DateTime respondedAt\n  -CheckInStatus status\n  +send() void\n  +markResponded() void\n}\nclass ExecutorAppointment {\n  -AppointmentStatus status\n  -DateTime appointedAt\n  -DateTime revokedAt\n  +revoke() void\n}\nclass BeneficiaryAssignment {\n  -HandoverStatus status\n  -DateTime assignedAt\n  -DateTime confirmedAt\n  +deliver() void\n  +confirmReceipt() void\n}\nclass HandoverProgress {\n  -ProcessStatus status\n  -int totalAssets\n  -int deliveredAssets\n  -int confirmedAssets\n  +start() void\n  +notifyExecutor() void\n  +updateProgress() void\n  +close() void\n}\nclass LegalVerificationRequest {\n  -String deathCertRef\n  -RequestStatus status\n  -DateTime submittedAt\n  -DateTime reviewedAt\n  +submit() void\n  +approve() void\n  +reject(reason) void\n}\nclass AuditLog {\n  -String action\n  -String targetVaultId\n  -DateTime timestamp\n  -bool isAnomalous\n}\nPerson &lt;|-- VaultOwner\nPerson &lt;|-- DigitalExecutor\nPerson &lt;|-- Beneficiary\nPerson &lt;|-- LegalVerifier\nPerson &lt;|-- SystemAdministrator\nVaultOwner \&quot;1\&quot; --&gt; \&quot;1..*\&quot; Vault : owns\nVault \&quot;1\&quot; *-- \&quot;0..*\&quot; DigitalAsset : contains\nVault \&quot;1\&quot; *-- \&quot;0..*\&quot; LegalDocument : stores\nVault \&quot;1\&quot; *-- \&quot;1\&quot; DeadManSwitch : guarded by\nDeadManSwitch \&quot;1\&quot; --&gt; \&quot;0..*\&quot; CheckInNotification : sends\nDeadManSwitch \&quot;1\&quot; --&gt; \&quot;0..1\&quot; HandoverProgress : triggers\nVault \&quot;1\&quot; --&gt; \&quot;0..*\&quot; ExecutorAppointment : has\nExecutorAppointment \&quot;0..*\&quot; --&gt; \&quot;1\&quot; DigitalExecutor : appoints\nDigitalAsset \&quot;1\&quot; --&gt; \&quot;0..*\&quot; BeneficiaryAssignment : assigned via\nBeneficiaryAssignment \&quot;0..*\&quot; --&gt; \&quot;1\&quot; Beneficiary : for\nHandoverProgress \&quot;1\&quot; --&gt; \&quot;0..*\&quot; BeneficiaryAssignment : tracks\nHandoverProgress \&quot;1\&quot; --&gt; \&quot;0..*\&quot; LegalVerificationRequest : requires\nDigitalExecutor \&quot;1\&quot; --&gt; \&quot;0..*\&quot; LegalVerificationRequest : submits\nLegalVerifier \&quot;1\&quot; --&gt; \&quot;0..*\&quot; LegalVerificationRequest : reviews\nPerson \&quot;1\&quot; --&gt; \&quot;0..*\&quot; AuditLog : performs\nSystemAdministrator \&quot;1\&quot; --&gt; \&quot;0..*\&quot; AuditLog : monitors&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="3oQl2XGfkcg0eAJt9rI_-1">
