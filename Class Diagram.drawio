        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\ndirection TB\n\nclass Person {\n  -UUID personId\n  -String fullName\n  -String email\n  -String phone\n  -PersonStatus status\n  +login() bool\n  +logout() void\n  +verifyOtp(code) bool\n}\nclass VaultOwner {\n  +createVault() Vault\n  +createAsset(data) DigitalAsset\n  +uploadLegalDocument(file) LegalDocument\n  +assignBeneficiary(asset, beneficiary) void\n  +appointExecutor(executor, instructions) void\n  +updateExecutor(appointment) void\n  +revokeExecutor(executor) void\n  +configureDeadManSwitch(config) void\n  +respondToCheckIn(notification) void\n  +viewAccessLog() List~AuditLog~\n}\nclass DigitalExecutor {\n  +viewAssignedAssets() List~DigitalAsset~\n  +submitVerificationRequest(cert) LegalVerificationRequest\n  +sendMessage(request, content) void\n  +trackHandoverProgress() HandoverCase\n}\nclass Beneficiary {\n  -KycStatus kycStatus\n  +verifyIdentity() bool\n  +viewInheritedAssets() List~DigitalAsset~\n  +downloadAsset(asset) File\n  +confirmReceipt(asset) void\n}\nclass LegalVerifier {\n  -String licenseNo\n  +reviewRequest(request) void\n  +verifySignature(doc) bool\n  +signApproval(request) void\n  +sendMessage(request, content) void\n  +viewVerifiedHistory() List~LegalVerificationRequest~\n}\nclass SystemAdministrator {\n  +manageUsers() void\n  +manageRoles() void\n  +monitorAuditLog() List~AuditLog~\n  +configurePolicy(policy) void\n  +manageIntegration(config) void\n}\n\n%% ===== Phân quyền (RBAC) =====\nclass Role {\n  -UUID roleId\n  -String roleName\n}\nclass Permission {\n  -UUID permissionId\n  -String code\n  -String description\n}\n\n%% ===== Vault và tài sản =====\nclass Vault {\n  -UUID vaultId\n  -String encryptionKeyRef\n  -VaultStatus status\n  +lock() void\n  +unlock(request) void\n}\nclass AssetGroup {\n  -UUID groupId\n  -String name\n}\nclass DigitalAsset {\n  -UUID assetId\n  -AssetType type\n  -String name\n  -Bytes encryptedData\n  +encrypt() void\n  +decrypt() Bytes\n}\nclass LegalDocument {\n  -UUID docId\n  -DocType docType\n  -Bytes encryptedFile\n  -String fileHash\n}\n\n%% ===== Dead Man&#39;s Switch =====\nclass DeadManSwitch {\n  -int checkInIntervalDays\n  -int gracePeriodDays\n  -DateTime lastCheckInAt\n  -SwitchStatus status\n  +recordCheckIn() void\n  +startWaiting() void\n  +trigger() HandoverCase\n}\nclass CheckInNotification {\n  -DateTime sentAt\n  -DateTime deadline\n  -DateTime respondedAt\n  -CheckInStatus status\n  +send() void\n  +markResponded() void\n}\n\n%% ===== Người thi hành và bàn giao =====\nclass ExecutorAppointment {\n  -AppointmentStatus status\n  -String handoverInstructions\n  -DateTime appointedAt\n  -DateTime revokedAt\n  +revoke() void\n}\nclass BeneficiaryAssignment {\n  -AssignmentStatus status\n  -DateTime assignedAt\n  -DateTime confirmedAt\n  +deliver() void\n  +confirmReceipt() void\n}\nclass HandoverCase {\n  -CaseStatus status\n  -int totalAssets\n  -int deliveredAssets\n  -int confirmedAssets\n  +start() void\n  +notifyExecutor() void\n  +updateProgress() void\n  +close() void\n}\n\n%% ===== Xác minh pháp lý =====\nclass LegalVerificationRequest {\n  -String deathCertRef\n  -RequestStatus status\n  -DateTime submittedAt\n  -DateTime reviewedAt\n  -String rejectionReason\n  -String digitalSignature\n  +submit() void\n  +approve(signature) void\n  +reject(reason) void\n}\nclass VerificationMessage {\n  -UUID messageId\n  -String content\n  -String attachmentRef\n  -DateTime sentAt\n}\n\n%% ===== Audit và quản trị =====\nclass AuditLog {\n  -UUID logId\n  -String action\n  -DateTime timestamp\n  -bool isAnomalous\n}\nclass SystemPolicy {\n  -UUID policyId\n  -String encryptionAlgorithm\n  -int backupFrequencyDays\n  -int defaultCheckInIntervalDays\n  -int defaultGracePeriodDays\n}\nclass IntegrationConfig {\n  -UUID integrationId\n  -IntegrationType type\n  -String providerName\n  -String endpointUrl\n  -bool enabled\n}\n\n%% ===== Quan hệ =====\nPerson &lt;|-- VaultOwner\nPerson &lt;|-- DigitalExecutor\nPerson &lt;|-- Beneficiary\nPerson &lt;|-- LegalVerifier\nPerson &lt;|-- SystemAdministrator\n\nPerson \&quot;*\&quot; -- \&quot;1..*\&quot; Role : has\nRole \&quot;*\&quot; -- \&quot;*\&quot; Permission : grants\n\nVaultOwner \&quot;1\&quot; -- \&quot;1..*\&quot; Vault : owns\nVault \&quot;1\&quot; *-- \&quot;0..*\&quot; AssetGroup : organizes\nVault \&quot;1\&quot; *-- \&quot;0..*\&quot; DigitalAsset : contains\nAssetGroup \&quot;0..1\&quot; o-- \&quot;0..*\&quot; DigitalAsset : groups\nVault \&quot;1\&quot; *-- \&quot;0..*\&quot; LegalDocument : stores\nVault \&quot;1\&quot; *-- \&quot;1\&quot; DeadManSwitch : guarded by\n\nDeadManSwitch \&quot;1\&quot; -- \&quot;0..*\&quot; CheckInNotification : sends\nDeadManSwitch \&quot;1\&quot; -- \&quot;0..1\&quot; HandoverCase : triggers\n\nVault \&quot;1\&quot; -- \&quot;0..*\&quot; ExecutorAppointment : has\nExecutorAppointment \&quot;0..*\&quot; -- \&quot;1\&quot; DigitalExecutor : appoints\n\nDigitalAsset \&quot;1\&quot; -- \&quot;0..1\&quot; BeneficiaryAssignment : assigned via\nBeneficiaryAssignment \&quot;0..*\&quot; -- \&quot;1\&quot; Beneficiary : for\nHandoverCase \&quot;1\&quot; -- \&quot;0..*\&quot; BeneficiaryAssignment : tracks\n\nHandoverCase \&quot;1\&quot; -- \&quot;0..*\&quot; LegalVerificationRequest : requires\nLegalVerificationRequest \&quot;0..*\&quot; -- \&quot;1\&quot; Vault : targets\nDigitalExecutor \&quot;1\&quot; -- \&quot;0..*\&quot; LegalVerificationRequest : submits\nLegalVerifier \&quot;1\&quot; -- \&quot;0..*\&quot; LegalVerificationRequest : reviews\nLegalVerificationRequest \&quot;1\&quot; *-- \&quot;0..*\&quot; VerificationMessage : discussed in\nPerson \&quot;1\&quot; -- \&quot;0..*\&quot; VerificationMessage : sends\n\nPerson \&quot;1\&quot; -- \&quot;0..*\&quot; AuditLog : performs\nVault \&quot;1\&quot; -- \&quot;0..*\&quot; AuditLog : logged in\nSystemAdministrator \&quot;1\&quot; -- \&quot;0..*\&quot; AuditLog : monitors\nSystemAdministrator \&quot;1\&quot; -- \&quot;0..*\&quot; SystemPolicy : configures\nSystemAdministrator \&quot;1\&quot; -- \&quot;0..*\&quot; IntegrationConfig : manages&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="c4z2vuag9FONNj_PxdJu-248">
