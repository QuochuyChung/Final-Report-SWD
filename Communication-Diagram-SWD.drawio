        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart LR\n  %% Actors\n  owner[\&quot;👤 Vault Owner\&quot;]\n  sched[\&quot;👤 System Scheduler&lt;br/&gt;(time actor)\&quot;]\n  exec[\&quot;👤 Digital Executor / Trustee\&quot;]\n  ver[\&quot;👤 Legal Verifier / Notary\&quot;]\n  ben[\&quot;👤 Beneficiary\&quot;]\n  adm[\&quot;👤 System Administrator\&quot;]\n \n  %% Internal components\n  vault[\&quot;:Vault Management Service\&quot;]\n  orch[\&quot;:Check-In &amp; Handover Orchestrator\&quot;]\n  notif[\&quot;:Notification Service\&quot;]\n  eb[\&quot;:Executor &amp; Beneficiary Service\&quot;]\n  lv[\&quot;:Legal Verification Service&lt;br/&gt;(+ kênh trao đổi)\&quot;]\n  iam[\&quot;:Identity &amp; Access Service\&quot;]\n  audit[\&quot;:Audit &amp; Monitoring Service\&quot;]\n  admsvc[\&quot;:Administration Service\&quot;]\n \n  %% External systems\n  prov([\&quot;:Email / SMS / Push Provider\&quot;])\n  sig([\&quot;:Digital Signature / e-Notary Service\&quot;])\n  otp([\&quot;:eKYC / OTP Service\&quot;])\n \n  owner ---|\&quot;▶ 1: createAsset(), uploadLegalDoc() [mã hóa E2E]\&quot;| vault\n  owner ---|\&quot;▶ 2: assignBeneficiary(), appointUpdateRevokeExecutor()\&quot;| eb\n  owner ---|\&quot;▶ 3: configureDMS(cycle, waitPeriod)&lt;br/&gt;▶ 5: [owner phản hồi] confirmAlive()\&quot;| orch\n  sched ---|\&quot;▶ 4: dueCheckIn()&lt;br/&gt;▶ 6: [hết thời gian chờ] waitPeriodExpired()\&quot;| orch\n  orch ---|\&quot;▶ 4.1: sendCheckIn()&lt;br/&gt;▶ 6.1: notifyExecutor()&lt;br/&gt;▶ 12.2.3: notifyBeneficiaries()\&quot;| notif\n  notif ---|\&quot;▶ 4.1.1 / 6.1.1 / 12.2.3.1: deliver(email/SMS/push)\&quot;| prov\n  exec ---|\&quot;▶ 7: viewAssetMetadata(), handoverInstructions() [BR-06]&lt;br/&gt;▶ 17: trackProgress()\&quot;| eb\n  exec ---|\&quot;▶ 8: submitVerificationRequest(deathCert)&lt;br/&gt;▶ 11: [bị từ chối] resubmit() qua kênh trao đổi\&quot;| lv\n  ver ---|\&quot;▶ 9: reviewRequest()&lt;br/&gt;▶ 10: [từ chối] reject(reason) / requestMoreDocs()&lt;br/&gt;▶ 12: [hợp lệ] approveAndSign()\&quot;| lv\n  lv ---|\&quot;▶ 9.1: verifyDigitalSignature()&lt;br/&gt;▶ 12.1: eSign(unlock)\&quot;| sig\n  lv ---|\&quot;▶ 12.2: onApproved() [BR-07]\&quot;| orch\n  orch ---|\&quot;▶ 12.2.1: unlockVault()\&quot;| vault\n  orch ---|\&quot;▶ 12.2.2: createHandoverCase(), createAssignment() per asset&lt;br/&gt;◀ 16.1: closeAsset()&lt;br/&gt;◀ 16.2: [mọi tài sản đã đóng] allClosed()\&quot;| eb\n  ben ---|\&quot;▶ 13: authenticate(OTP/eKYC) [BR-09]\&quot;| iam\n  iam ---|\&quot;▶ 13.1: verifyIdentity()\&quot;| otp\n  ben ---|\&quot;▶ 14: listMyAssets()&lt;br/&gt;▶ 15: downloadDecrypted()&lt;br/&gt;▶ 16: confirmReceipt()\&quot;| eb\n  eb ---|\&quot;▶ 15.1: releaseDecryptedAsset()\&quot;| vault\n  orch ---|\&quot;▶ 4.2 / 5.1 / 6.2 / 12.2.4 / 16.2.1: logStateChange() [BR-11]\&quot;| audit\n  lv ---|\&quot;▶ 8.1 / 10.1: logVerificationEvent()\&quot;| audit\n  owner ---|\&quot;▶ 18: viewActivityLog()\&quot;| audit\n  adm ---|\&quot;▶ 19: monitorAuditLog(), abnormalAccessAlerts()\&quot;| audit\n  adm ---|\&quot;▶ 20: manageUsers/RBAC, policies, integrations\&quot;| admsvc\n \n  classDef ext fill:#f2f2f2,stroke:#000,stroke-dasharray:5 3;\n  class prov,sig,otp ext;&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="Y6RxJhvi-dOQ-CaqSJ1I-113">
