        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nerDiagram\n    USERS {\n        uuid user_id PK\n        string full_name\n        string email UK\n        string password_hash\n        string account_status\n        datetime created_at\n        datetime updated_at\n    }\n\n    ROLES {\n        uuid role_id PK\n        string role_name UK\n        string description\n    }\n\n    USER_ROLES {\n        uuid user_role_id PK\n        uuid user_id FK\n        uuid role_id FK\n        datetime assigned_at\n    }\n\n    VAULTS {\n        uuid vault_id PK\n        uuid owner_id FK\n        string vault_name\n        string vault_status\n        datetime created_at\n        datetime updated_at\n    }\n\n    DIGITAL_ASSETS {\n        uuid asset_id PK\n        uuid vault_id FK\n        string asset_name\n        string asset_type\n        string encrypted_data_ref\n        string encryption_algorithm\n        string asset_status\n        datetime created_at\n    }\n\n    VAULT_DOCUMENTS {\n        uuid document_id PK\n        uuid vault_id FK\n        string document_name\n        string document_type\n        string encrypted_file_ref\n        datetime uploaded_at\n    }\n\n    BENEFICIARY_ASSIGNMENTS {\n        uuid assignment_id PK\n        uuid asset_id FK\n        uuid beneficiary_id FK\n        string assignment_status\n        datetime assigned_at\n    }\n\n    EXECUTOR_AUTHORIZATIONS {\n        uuid authorization_id PK\n        uuid vault_id FK\n        uuid executor_id FK\n        string authorization_status\n        datetime granted_at\n        datetime revoked_at\n    }\n\n    DEAD_MAN_SWITCHES {\n        uuid switch_id PK\n        uuid vault_id FK\n        int check_interval_days\n        int grace_period_days\n        datetime next_check_at\n        string switch_status\n    }\n\n    LIVENESS_CHECKS {\n        uuid check_id PK\n        uuid switch_id FK\n        datetime scheduled_at\n        datetime responded_at\n        string check_status\n    }\n\n    HANDOVER_CASES {\n        uuid case_id PK\n        uuid vault_id FK\n        string trigger_reason\n        string case_status\n        datetime initiated_at\n        datetime completed_at\n    }\n\n    LEGAL_VERIFICATIONS {\n        uuid verification_id PK\n        uuid case_id FK\n        uuid submitted_by FK\n        uuid verifier_id FK\n        uuid provider_id FK\n        string verification_status\n        string digital_signature_ref\n        datetime submitted_at\n        datetime reviewed_at\n    }\n\n    VERIFICATION_DOCUMENTS {\n        uuid verification_document_id PK\n        uuid verification_id FK\n        uuid uploaded_by FK\n        string document_type\n        string encrypted_file_ref\n        string signature_status\n        datetime uploaded_at\n    }\n\n    VERIFICATION_MESSAGES {\n        uuid message_id PK\n        uuid verification_id FK\n        uuid sender_id FK\n        string encrypted_message_ref\n        datetime sent_at\n    }\n\n    IDENTITY_VERIFICATIONS {\n        uuid identity_verification_id PK\n        uuid user_id FK\n        uuid provider_id FK\n        string verification_method\n        string verification_status\n        datetime verified_at\n        datetime expires_at\n    }\n\n    ASSET_HANDOVERS {\n        uuid handover_id PK\n        uuid case_id FK\n        uuid assignment_id FK\n        uuid identity_verification_id FK\n        string handover_status\n        datetime access_granted_at\n        datetime acknowledged_at\n    }\n\n    NOTIFICATIONS {\n        uuid notification_id PK\n        uuid user_id FK\n        uuid case_id FK\n        string notification_type\n        string notification_status\n        datetime sent_at\n        datetime read_at\n    }\n\n    AUDIT_LOGS {\n        uuid log_id PK\n        uuid actor_id FK\n        uuid vault_id FK\n        string action_type\n        string resource_type\n        string resource_id\n        datetime occurred_at\n    }\n\n    SECURITY_ALERTS {\n        uuid alert_id PK\n        uuid log_id FK\n        string severity\n        string alert_status\n        datetime detected_at\n        datetime resolved_at\n    }\n\n    SYSTEM_POLICIES {\n        uuid policy_id PK\n        uuid updated_by FK\n        string policy_category\n        string policy_key\n        string policy_value\n        datetime updated_at\n    }\n\n    EXTERNAL_PROVIDERS {\n        uuid provider_id PK\n        string provider_name\n        string provider_type\n        string provider_status\n    }\n\n    USERS ||--|{ USER_ROLES : has\n    ROLES ||--|{ USER_ROLES : assigned_to\n\n    USERS ||--|{ VAULTS : owns\n    VAULTS ||--|{ DIGITAL_ASSETS : contains\n    VAULTS ||--|{ VAULT_DOCUMENTS : stores\n\n    DIGITAL_ASSETS ||--|{ BENEFICIARY_ASSIGNMENTS : assigned_to\n    USERS ||--|{ BENEFICIARY_ASSIGNMENTS : receives\n\n    VAULTS ||--|{ EXECUTOR_AUTHORIZATIONS : grants\n    USERS ||--|{ EXECUTOR_AUTHORIZATIONS : executes\n\n    VAULTS ||--|| DEAD_MAN_SWITCHES : configures\n    DEAD_MAN_SWITCHES ||--|{ LIVENESS_CHECKS : schedules\n\n    VAULTS ||--|{ HANDOVER_CASES : initiates\n\n    HANDOVER_CASES ||--|{ LEGAL_VERIFICATIONS : requires\n    USERS ||--|{ LEGAL_VERIFICATIONS : submits\n    USERS ||--|{ LEGAL_VERIFICATIONS : reviews\n\n    LEGAL_VERIFICATIONS ||--|{ VERIFICATION_DOCUMENTS : includes\n    USERS ||--|{ VERIFICATION_DOCUMENTS : uploads\n\n    LEGAL_VERIFICATIONS ||--|{ VERIFICATION_MESSAGES : contains\n    USERS ||--|{ VERIFICATION_MESSAGES : sends\n\n    HANDOVER_CASES ||--|{ ASSET_HANDOVERS : contains\n    BENEFICIARY_ASSIGNMENTS ||--|{ ASSET_HANDOVERS : fulfills\n\n    USERS ||--|{ IDENTITY_VERIFICATIONS : completes\n    IDENTITY_VERIFICATIONS ||--|{ ASSET_HANDOVERS : authorizes\n\n    USERS ||--|{ NOTIFICATIONS : receives\n    HANDOVER_CASES ||--|{ NOTIFICATIONS : triggers\n\n    USERS ||--|{ AUDIT_LOGS : performs\n    VAULTS ||--|{ AUDIT_LOGS : records\n    AUDIT_LOGS ||--|{ SECURITY_ALERTS : generates\n\n    USERS ||--|{ SYSTEM_POLICIES : updates\n\n    EXTERNAL_PROVIDERS ||--|{ IDENTITY_VERIFICATIONS : processes\n    EXTERNAL_PROVIDERS ||--|{ LEGAL_VERIFICATIONS : supports\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="2XwwP820gFkRVOhYqAKQ-563">
