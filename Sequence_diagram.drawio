<mxCell id="frg2" value="[for each asset of the vault]" style="text;html=1;align=left;verticalAlign=middle;fontStyle=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="566.0" y="1323" width="360" height="20" as="geometry"/></mxCell>
<mxCell id="notePre" value="&lt;b&gt;Precondition:&lt;/b&gt; Dead Man&amp;#39;s Switch is Triggered; Executor and Verifier are logged in." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;spacingLeft=6;fontSize=11;fillColor=#fffde7;strokeColor=#b0a000;" vertex="1" parent="1"><mxGeometry x="300" y="140" width="520" height="34" as="geometry"/></mxCell>
<mxCell id="note0" value="&lt;b&gt;Phase 1&lt;/b&gt; - Executor submits the death certificate." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;spacingLeft=6;fontSize=11;fillColor=#fffde7;strokeColor=#b0a000;" vertex="1" parent="1"><mxGeometry x="2110" y="220" width="270" height="34" as="geometry"/></mxCell>
<mxCell id="note1" value="&lt;b&gt;Phase 2&lt;/b&gt; - Verifier opens the request. The system checks the digital signature automatically." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;spacingLeft=6;fontSize=11;fillColor=#fffde7;strokeColor=#b0a000;" vertex="1" parent="1"><mxGeometry x="2110" y="772" width="270" height="60" as="geometry"/></mxCell>
<mxCell id="note2" value="&lt;b&gt;Approve&lt;/b&gt; - e-sign, unlock the vault, hand over each asset and notify people." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;spacingLeft=6;fontSize=11;fillColor=#fffde7;strokeColor=#b0a000;" vertex="1" parent="1"><mxGeometry x="2110" y="1038" width="270" height="46" as="geometry"/></mxCell>
<mxCell id="note3" value="Assets are not decrypted here. Each Beneficiary decrypts after OTP / eKYC." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;spacingLeft=6;fontSize=11;fillColor=#fffde7;strokeColor=#b0a000;" vertex="1" parent="1"><mxGeometry x="2110" y="1344" width="270" height="46" as="geometry"/></mxCell>
<mxCell id="note4" value="&lt;b&gt;Reject&lt;/b&gt; - a reason is required. Executor can add documents through the integrated channel and resubmit (status back to Pending)." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;spacingLeft=6;fontSize=11;fillColor=#fffde7;strokeColor=#b0a000;" vertex="1" parent="1"><mxGeometry x="2110" y="1680" width="270" height="74" as="geometry"/></mxCell>
